{
  "name": "Aquizi - AI-Powered Vocabulary Learning",
  "short_name": "Aquizi",
  "description": "Learn vocabulary with AI-powered interactive practice",
  "start_url": "/vocabulary",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#004d7a",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Vocabulary Practice",
      "short_name": "Practice",
      "description": "Begin a vocabulary practice session",
      "url": "/vocabulary",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "View Leaderboard",
      "short_name": "Leaderboard",
      "description": "Check your vocabulary ranking",
      "url": "/vocabulary?tab=leaderboard",
      "icons": [
        {
          "src": "/icons/icon-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "serviceworker": {
    "src": "/custom-sw.js",
    "scope": "/"
  },
  "prefer_related_applications": false
}
